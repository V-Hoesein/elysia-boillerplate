{
  "name": "elysia-boillerplate",
  "version": "1.0.50",
  "type": "module",
  "scripts": {
    "test": "NODE_ENV=test bun test tests/unit tests/integration/app.test.ts",
    "dev": "bun --watch src/server.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --target bun --outdir build",
    "typecheck": "tsc --noEmit",
    "test:watch": "NODE_ENV=test bun test --watch tests/unit tests/integration/app.test.ts",
    "test:database": "NODE_ENV=test bun test tests/integration/database.test.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:push": "bunx --bun drizzle-kit push",
    "db:studio": "bunx --bun drizzle-kit studio"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "**/*.{json,jsonc,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
